<?xml version="1.0" encoding="utf-8"?>

<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        checked = true
        代表密碼現在是「顯示」狀態
        所以使用張開眼睛
    -->
    <item
        android:state_checked="true"
        android:drawable="@drawable/ic_visibility" />

    <!--
        預設 checked = false
        密碼隱藏
        所以使用眼睛上一撇
    -->
    <item
        android:drawable="@drawable/ic_visibility_off" />

</selector>