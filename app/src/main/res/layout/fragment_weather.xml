<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:fillViewport="true">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="20dp">


        <Button
            android:id="@+id/btnBack"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="回首頁" />


        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center_horizontal"

            android:layout_marginTop="15dp"

            android:text="地區天氣"

            android:textSize="30sp"
            android:textStyle="bold" />


        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="30dp"

            android:text="選擇縣市"

            android:textSize="18sp"
            android:textStyle="bold" />


        <Spinner
            android:id="@+id/spinnerCity"

            android:layout_width="match_parent"
            android:layout_height="55dp" />


        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="15dp"

            android:text="選擇鄉鎮市區"

            android:textSize="18sp"
            android:textStyle="bold" />


        <Spinner
            android:id="@+id/spinnerTown"

            android:layout_width="match_parent"
            android:layout_height="55dp" />


        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            android:text="預報方式"

            android:textSize="18sp"
            android:textStyle="bold" />


        <RadioGroup
            android:id="@+id/weatherModeGroup"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:gravity="center_vertical">


            <RadioButton
                android:id="@+id/radioThreeDay"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:checked="true"

                android:text="三天預報"

                android:textSize="18sp" />


            <RadioButton
                android:id="@+id/radioWeek"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="30dp"

                android:text="一週預報"

                android:textSize="18sp" />


        </RadioGroup>


        <Button
            android:id="@+id/btnSearchWeather"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            android:text="查詢天氣" />


        <ProgressBar
            android:id="@+id/weatherLoading"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center_horizontal"

            android:layout_marginTop="20dp"

            android:visibility="gone" />


        <TextView

            android:id="@+id/tvSelectedLocation"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"

            android:text="尚未查詢地區"

            android:textSize="22sp"
            android:textStyle="bold" />


        <TextView

            android:id="@+id/tvForecastType"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="三天預報"

            android:textSize="18sp" />


        <TextView

            android:id="@+id/tvLastUpdate"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="資料更新時間：--"

            android:textSize="14sp" />


        <View

            android:layout_width="match_parent"
            android:layout_height="1dp"

            android:layout_marginTop="20dp"
            android:layout_marginBottom="15dp"

            android:background="#CCCCCC" />


        <LinearLayout
            android:id="@+id/forecastContainer"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical" />


        <View

            android:layout_width="match_parent"
            android:layout_height="50dp" />


    </LinearLayout>

</androidx.core.widget.NestedScrollView>